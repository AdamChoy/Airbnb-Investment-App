import streamlit as st
from pyspark.sql.functions import col
from openai import OpenAI

client = OpenAI()

# ---------- Helpers ----------

def spark_to_dict(row):
    return row.asDict() if row is not None else {}

def summarise_reviews_with_llm(area_name, reviews):
    prompt = f"""
    You are analysing Airbnb guest reviews for the area: {area_name}.
    Only summarise themes that appear in the provided reviews.
    Do NOT invent facts or mention anything not present in the text.

    Reviews:
    {reviews}

    Extract:
    - Common positive themes
    - Common negative themes
    - Sentiment summary (positive / mixed / negative)
    - 3–5 bullet points of key insights

    Return output as a concise explanation in plain English.
    """

    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.2
    )
    return response.choices[0].message.content


def explain_investment_score(area_metrics: dict, persona: dict):
    prompt = f"""
    You are generating an explanation for an investment score.
    Only use the metrics provided below. Do NOT invent external facts.

    Area metrics:
    {area_metrics}

    Persona:
    {persona}

    Explain:
    - Why the investment score is high or low
    - Which metrics contributed most (based on persona weights)
    - Any risks or weaknesses visible in the data
    - A concise 3–4 sentence summary in plain English

    Keep the explanation factual and grounded in the numbers.
    """

    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.2
    )
    return response.choices[0].message.content


def recommend_area(area_metrics: dict, review_summary: str, persona: dict):
    prompt = f"""
    You are generating a final investment recommendation for an area.
    Only use the data provided. Do NOT invent external facts.

    Area metrics:
    {area_metrics}

    Review summary:
    {review_summary}

    Persona:
    {persona}

    Produce:
    - A clear recommendation (good / moderate / poor fit)
    - Why this area suits the persona
    - How the review themes support or weaken the score
    - A final 3–5 bullet point summary

    Keep everything grounded in the supplied data.
    """

    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.2
    )
    return response.choices[0].message.content


