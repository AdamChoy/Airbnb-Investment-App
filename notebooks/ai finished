def summarise_reviews_with_llm(area_name, reviews):
    prompt = f"""
    Summarise Airbnb guest reviews for: {area_name}.
    Only use the provided reviews. Do NOT invent facts.

    Reviews:
    {reviews}

    Extract:
    - Positive themes
    - Negative themes
    - Sentiment (positive / mixed / negative)
    - 3–5 key insights
    """

    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.2
    )
    return response.choices[0].message.content


